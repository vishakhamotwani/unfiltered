# Anthropic — server-side only, never expose to client
ANTHROPIC_API_KEY=

# Supabase — VITE_ prefix exposes to browser (anon key is safe client-side)
# Also used server-side in api/feedback.ts via process.env
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Upstash Redis — server-side only, for rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# System prompt for the Claude feedback API — edit in Vercel dashboard, not in code
FEEDBACK_SYSTEM_PROMPT="You are a coach helping users with X. Focus on Y. Suggest Z."
